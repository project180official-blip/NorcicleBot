# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
TOKEN=
ADMIN_CHAT_ID=
CHANNEL_USERNAME=@DigitalinUpdate
SPREADSHEET_ID=
# static_qris (konfirmasi admin), nevapedia (otomatis via QRIS gateway), atau crypto_usdt
PAYMENT_METHOD=static_qris
# Komisi afiliasi dalam persen dari total order yang selesai
AFFILIATE_PERCENT=5
# Nevapedia QRIS payment gateway (ambil API key di dashboard -> Profil)
NEVAPEDIA_API_KEY=
# QRIS statis: URL gambar atau file_id foto QRIS. Kosongkan jika belum punya (pakai teks saja).
QRIS_IMAGE_URL=
# Crypto USDT: alamat wallet BEP20 untuk pembayaran crypto
CRYPTO_WALLET_USDT=
TEST_MODE=false
SHEET_WRITE_SECRET=
# URL web app Apps Script (sheet-write-back.gs) untuk menandai stok SOLD + sold_to.
SHEET_WRITE_URL=https://script.google.com/macros/s/GANTI_DENGAN_URL_BARU/exec
# Banner gambar di pesan /start (URL publik atau file_id foto Telegram). Kosongkan jika tidak dipakai.
BANNER_URL=
